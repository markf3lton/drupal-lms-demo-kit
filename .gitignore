# Composer-managed dependencies (paths match extra.installer-paths).
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Site-specific settings; settings.php itself is tracked for DDEV.
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# User-generated content and test sites.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/simpletest/

# Debug log written by lrs_xapi's endpoint; holds raw requests with cookies.
/web/requests.txt
